{
  "name": "@repo/api",
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "check-types": "tsc --noEmit",
    "d1:migrate:local": "wrangler d1 execute ai-agent-local-auth --local --config wrangler.jsonc --file=./migrations/0001_admin_auth.sql",
    "d1:reset:local": "rm -rf .wrangler/state/v3/d1 && wrangler d1 execute ai-agent-local-auth --local --config wrangler.jsonc --file=./migrations/0001_admin_auth.sql",
    "d1:seed:local": "wrangler d1 execute ai-agent-local-auth --local --config wrangler.jsonc --file=./dev/seed-admin.sql"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@repo/contracts": "workspace:*",
    "hono": "catalog:",
    "jose": "^6.2.4",
    "uuidv7": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "wrangler": "^4.110.0",
    "@types/node": "catalog:"
  }
}